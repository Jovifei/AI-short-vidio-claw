{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render_record.schema.json",
  "title": "ComfyUI Render Record",
  "type": "object",
  "required": [
    "shot_id",
    "workflow",
    "input_keyframe",
    "render",
    "result"
  ],
  "properties": {
    "shot_id": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "input_keyframe": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "render": {
      "type": "object",
      "required": [
        "width",
        "height",
        "frames"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": [
            "number",
            "null"
          ]
        },
        "steps": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cfg": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_vram_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "peak_ram_bytes": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "result": {
      "enum": [
        "success",
        "failed",
        "rejected_by_guard"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputs": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
