{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval_manifest.schema.json",
  "title": "Production Approval Manifest",
  "type": "object",
  "required": [
    "status",
    "shots"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "visual_target_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "approved_by_user": {
      "type": "boolean"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "shots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "approved_by_user"
        ],
        "properties": {
          "status": {
            "enum": [
              "DRAFT",
              "CANDIDATE",
              "RECOMMENDED",
              "USER_APPROVED",
              "PRODUCTION_READY",
              "VIDEO_ACCEPTED",
              "STATIC_ACCEPTED",
              "SUPERSEDED",
              "REJECTED"
            ]
          },
          "approved_keyframe": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "identity_refs": {
            "type": "object"
          },
          "costume_refs": {
            "type": "object"
          },
          "motion_tier": {
            "enum": [
              "M0",
              "M1",
              "M2",
              "M3",
              null
            ]
          },
          "approved_by_user": {
            "type": "boolean"
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
