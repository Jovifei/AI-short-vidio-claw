{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reference_manifest.schema.json",
  "title": "Character Reference Manifest",
  "type": "object",
  "required": [
    "character_id",
    "status",
    "visual_target_id",
    "references"
  ],
  "properties": {
    "character_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "CANDIDATE",
        "PREPROD_APPROVED",
        "USER_APPROVED",
        "SUPERSEDED"
      ]
    },
    "visual_target_id": {
      "type": "string"
    },
    "approved_by_user": {
      "type": "boolean"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "golden_face_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "golden_costume_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref_id",
          "local_relative_path",
          "sha256",
          "type",
          "approved_by_user"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "local_relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "type": {
            "enum": [
              "face",
              "costume",
              "full_body",
              "hair",
              "prop",
              "composition",
              "model_sheet"
            ]
          },
          "angle": {
            "type": [
              "string",
              "null"
            ]
          },
          "approved_by_user": {
            "type": "boolean"
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
