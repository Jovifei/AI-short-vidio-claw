# Do not commit real keys or machine-specific secrets.

# P0R must discover the actual local ComfyUI endpoint.
# Upstream ComfyUI default is 8188, but Desktop/local configuration may differ.
COMFYUI_URL=

# P5 only. Official GPT-SoVITS api_v2 default is 9880.
GPT_SOVITS_URL=http://127.0.0.1:9880

# P5 only. Official MuseTalk Gradio app default is 7860.
# This is not a stable production API contract; adapter work is required.
MUSETALK_UI_URL=http://127.0.0.1:7860

PROJECT_DATA_DIR=./local
